# ─── Vercel KV (Redis) ────────────────────────────────────────────────────────
# Activar en vercel.com/dashboard → Storage → KV
# Luego correr: npx vercel env pull .env.local
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ─── Supabase (auth) ─────────────────────────────────────────────────────────
# supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ─── Duffel (vuelos) ─────────────────────────────────────────────────────────
# duffel.com → Developers → Access tokens
DUFFEL_API_KEY=duffel_test_your_key_here

# ─── Slack ────────────────────────────────────────────────────────────────────
# api.slack.com → tu app → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=

# api.slack.com → tu app → OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=

# ID del canal #travel donde Eba escucha mensajes (ej: C08XXXXXXX)
SLACK_TRAVEL_CHANNEL_ID=
